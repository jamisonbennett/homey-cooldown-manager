{
  "id": "us.jamisonbennett.apps.cooldown-manager",
  "version": "0.0.1",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Cooldown Manager"
  },
  "description": {
    "en": "Keep Flows from triggering too often with reusable cooldowns, multi-run limits, block-count alerts, and manual override cards."
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jamison Bennett",
    "email": ""
  },
  "brandColor": "#4F8CFF",
  "support": "https://github.com/jamisonbennett/homey-cooldown-manager",
  "api": {
    "getDisplayContext": {
      "method": "GET",
      "path": "/display-context"
    },
    "getFlowConfigErrors": {
      "method": "GET",
      "path": "/flow-config-errors"
    },
    "getTriggers": {
      "method": "GET",
      "path": "/triggers"
    }
  }
}
